<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/add_exercise_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/lang_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/lang_layout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_new_exercise"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/add_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/exercise_name_hint"
                android:textColor="@color/white"
                android:textColorHint="@android:color/darker_gray" />

            <EditText
                android:id="@+id/add_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/description_hint"
                android:lines="5"
                android:gravity="top"
                android:textColor="@color/white"
                android:textColorHint="@android:color/darker_gray" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/muscle_group_hint"
                android:textColor="@color/white"
                android:layout_marginTop="8dp"/>

            <EditText
                android:id="@+id/add_muscle_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/muscle_group_example"
                android:textColor="@color/white"
                android:textColorHint="@android:color/darker_gray" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/image_gif_optional"
                android:textColor="@color/white"
                android:layout_marginTop="16dp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_pick_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pick_from_device"
                app:backgroundTint="@color/red"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tv_image_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"
                android:text="@string/no_image_selected"
                android:layout_marginTop="4dp"/>

            <Button
                android:id="@+id/btn_save_exercise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_exercise"
                app:backgroundTint="@color/red"
                android:layout_marginTop="24dp"/>

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/btn_back_add"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_revert"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        app:tint="@color/red"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
