<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialog_workout_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_workout"
        android:textColor="@color/red"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/dialog_workout_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/workout_title"
        android:textColor="@android:color/darker_gray"
        android:textSize="12sp"
        android:fontFamily="serif"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/dialog_workout_name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#2C2C2C"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:hint="@string/workout_title_hint"
        android:textColor="@color/white"
        android:textColorHint="@android:color/darker_gray"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/dialog_cancel_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel"
            android:fontFamily="serif"
            android:textColor="@color/white"
            app:backgroundTint="#2C2C2C" />

        <Button
            android:id="@+id/dialog_add_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/add"
            android:fontFamily="serif"
            android:textColor="@color/white"
            app:backgroundTint="@color/red" />

    </LinearLayout>

</LinearLayout>
